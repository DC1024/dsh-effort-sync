{
  "name": "dsh-effort-sync",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Sync DSH model catalog reasoning levels (reasoningEfforts) from what the provider advertises on /v1/models — via the sync_reasoning_levels tool or one button on the Models settings page.",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "reasoning-effort"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DC1024/dsh-effort-sync.git"
  },
  "homepage": "https://github.com/DC1024/dsh-effort-sync#readme",
  "license": "MIT"
}